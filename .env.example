# === Required ===
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/
MONGO_DATABASE=HowNotToKillYourPlants
JWT_SECRET=generate-a-secure-random-string-at-least-32-chars

# === Collections (optional) ===
MONGO_USER_PROFILES_COLLECTION=UserCollection
MONGO_USER_GARDEN_COLLECTION=User_Garden_Collection
PLANT_DEATH_COLLECTION=PlantDeathCollection
# Preferred plant catalog (aligns with ETL / training)
NEW_PLANT_COLLECTION=NewPlantCollection
# Legacy name if NEW_PLANT_COLLECTION is unset
# PLANT_MONGO_COLLECTION=PlantCollection
MONGO_TOKEN_BLACKLIST_COLLECTION=TokenBlacklist

# === ML & APIs ===
VOYAGE_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
VECTOR_SEARCH_INDEX=vector_index

# === Permapeople (for permapeople_plant.py) ===
PERMAPEOPLE_KEY_ID=
PERMAPEOPLE_KEY_SECRET=

# === Reddit (for ETL.py) ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:HowToKeepYourPlantsAlive/1.0

# === Production (set when deploying) ===
# Frontend URL - used by backend for CORS (comma-separated for multiple)
CORS_ORIGINS=https://how-to-not-kill-your-plants.vercel.app
# Backend URL - used by frontend to call API (set in Vercel env vars)
NEXT_PUBLIC_API_URL=https://howtonotkillyourplants-production.up.railway.app

# === Optional ===
USE_RERANK=true
USE_GEMINI=true
GEMINI_MODEL=gemini-2.5-flash
# Recommendation cache (optional). Requires redis-py: pip install redis
USE_REDIS_CACHE=false

# --- Redis: pick ONE style ---

# Option A — single URL (local or Redis Cloud; use rediss:// for TLS on cloud):
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=rediss://default:YOUR_PASSWORD@redis-12345.c244.us-east-1-2.ec2.cloud.redislabs.com:12345/0

# Option B — discrete (matches Redis Cloud "Redis URL" / connection fields in dashboard):
# REDIS_HOST=redis-12345.c244.us-east-1-2.ec2.cloud.redislabs.com
# REDIS_PORT=12345
# REDIS_USERNAME=default
# REDIS_PASSWORD=your_password_here
# REDIS_SSL=false   # use "true" only if you use the TLS endpoint/port from the dashboard (often 6380 / rediss://)
# If you see SSL: WRONG_VERSION_NUMBER, you enabled TLS on a plaintext port — set REDIS_SSL=false or switch to rediss:// + TLS port.

RECOMMEND_CACHE_TTL=300
