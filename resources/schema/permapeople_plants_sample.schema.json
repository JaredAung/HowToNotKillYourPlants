      "Days to harvest": ["120-150", "45", "45-80", "45-85", "60", "65", "67", "70", "80"]
    },
    "info": {
      "Alternate name": "10+",
      "Family": "10+",
      "Genus": ["Allium", "Borago", "Malus", "Photinia", "Phytolacca", "Rubus"],
      "Native to": "10+",
      "Introduced into": "10+",
      "Wikipedia": "10+",
      "Plants For A Future": "10+",
      "Plants of the World Online": "10+",
      "Plants of the World Online Name (Synonym)": "10+",
      "Plants of the World Online Link (Synonym)": "10+",
      "North Carolina Extension Gardener Plant Toolbox": ["https://plants.ces.ncsu.edu/plants/salvia-lyrata/"],
