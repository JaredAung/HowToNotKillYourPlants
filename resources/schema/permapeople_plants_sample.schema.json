{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "permapeople-plants-sample",
  "title": "Permapeople Plants Sample Schema",
  "description": "Full schema for resources/permapeople_plants_sample.json",
  "type": "object",
  "required": ["plants"],
  "properties": {
    "plants": {
      "type": "array",
      "description": "List of plant records",
      "items": { "$ref": "#/definitions/Plant" }
    }
  },
  "definitions": {
    "Plant": {
      "type": "object",
      "required": ["id", "name", "slug"],
      "description": "A single plant record from Permapeople API",
      "properties": {
        "id": {
          "type": "integer",
          "description": "Unique plant identifier"
        },
        "name": {
          "type": "string",
          "description": "Common name"
        },
        "slug": {
          "type": "string",
          "description": "URL-safe identifier (e.g. cucurbita-moschata-squash)"
        },
        "scientific_name": {
          "type": ["string", "null"],
          "description": "Latin / botanical name"
        },
        "description": {
          "type": ["string", "null"],
          "description": "Long-form text description"
        },
        "data": {
          "type": "array",
          "description": "Key-value attributes (variable per plant)",
          "items": { "$ref": "#/definitions/DataEntry" }
        },
        "created_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 creation timestamp"
        },
        "updated_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO 8601 last update timestamp"
        },
        "parent_id": {
          "type": ["integer", "null"],
          "description": "Parent plant ID for varieties/cultivars"
        },
        "adopter_id": {
          "type": ["integer", "null"],
          "description": "Adopter / maintainer ID"
        },
        "version": {
          "type": ["integer", "null"],
          "description": "Record version number"
        },
        "type": {
          "type": "string",
          "enum": ["Plant"],
          "description": "Record type"
        },
        "link": {
          "type": ["string", "null"],
          "description": "Relative path (e.g. /plants/cucurbita-moschata-squash)"
        },
        "images": {
          "type": ["object", "null"],
          "description": "Image URLs",
          "properties": {
            "thumb": {
              "type": "string",
              "format": "uri",
              "description": "Thumbnail image URL"
            },
            "title": {
              "type": "string",
              "format": "uri",
              "description": "Primary / title image URL"
            }
          }
        },
        "care_level": {
          "type": ["string", "null"],
          "enum": ["easy", "medium", "hard"],
          "description": "Estimated care difficulty: easy (<40), medium (40-59), hard (60+)"
        },
        "difficulty_score": {
          "type": ["number", "null"],
          "description": "Numeric difficulty 0-100 (higher = harder)"
        }
      }
    },
    "DataEntry": {
      "type": "object",
      "required": ["key", "value"],
      "description": "Single attribute key-value pair in plant.data",
      "properties": {
        "key": {
          "type": "string",
          "description": "Attribute name"
        },
        "value": {
          "type": "string",
          "description": "Attribute value"
        }
      }
    }
  },
  "environment": [
    "USDA Hardiness zone",
    "Light requirement",
    "Water requirement",
    "Soil type",
    "Soil pH",
    "Drought resistant",
    "Root depth",
    "Root type",
    "Height",
    "Width",
    "Spacing",
    "Life cycle",
    "Layer",
    "Growth",
    "Pollination",
    "Habitat",
    "Nitrogen Fixing",
    "Nitrogen Usage",
    "Propagation method",
    "Propagation - Cuttings",
    "Propagation - Direct sowing",
    "Propagation - Transplanting",
    "When to sow (indoors)",
    "When to sow (outdoors)",
    "When to plant (transplant)",
    "When to plant (cuttings)",
    "When to plant (division)",
    "When to start indoors (weeks)",
    "When to start outdoors (weeks)",
    "Germination temperature",
    "Germination time",
    "Cold stratification temperature",
    "Cold stratification time",
    "Seed planting depth",
    "Seed viability",
    "1000 Seed Weight (g)",
    "Days to maturity",
    "Days to harvest"
  ],
  "info": [
    "Alternate name",
    "Family",
    "Genus",
    "Native to",
    "Introduced into",
    "Wikipedia",
    "Plants For A Future",
    "Plants of the World Online",
    "Plants of the World Online Name (Synonym)",
    "Plants of the World Online Link (Synonym)",
    "North Carolina Extension Gardener Plant Toolbox",
    "PIEDMONT NATIVE PLANTS: A GUIDE FOR LANDSCAPES AND GARDENS, 2ND EDITION",
    "Frontiers in Pharmacology",
    "Edible",
    "Edible parts",
    "Edible uses",
    "Medicinal",
    "Medicinal parts",
    "Utility",
    "Leaves"
  ],
  "problems": [
    "Diseases",
    "Pests",
    "Warning"
  ],
